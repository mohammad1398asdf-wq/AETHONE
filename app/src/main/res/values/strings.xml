    <!-- Protocol picker -->
    <string name="protocol_title">Protocol</string>
    <string name="protocol_masque">MASQUE</string>
    <string name="protocol_masque_desc">Hides the tunnel inside ordinary HTTPS traffic. Best against heavy filtering.</string>
    <string name="protocol_wireguard">WIREGUARD</string>
    <string name="protocol_wireguard_desc">Fast and lightweight. Use when the network is less aggressive.</string>
    <string name="protocol_gool">GOOL</string>
    <string name="protocol_gool_desc">WireGuard inside a MASQUE tunnel – different exit IP, more resistance.</string>
    <string name="protocol_gool_classic">GOOL CLASSIC</string>
    <string name="protocol_gool_classic_desc">WireGuard inside WireGuard. Different exit IP, highest latency.</string>
    <string name="protocol_mim">MIM</string>
    <string name="protocol_mim_desc">MASQUE inside MASQUE – when a single tunnel keeps exiting in the wrong country.</string>
    <string name="protocol_tor">TOR</string>
    <string name="protocol_tor_desc">Tor through the tunnel – maximum anonymity, slower.</string>
    <string name="protocol_tor_reverse">TOR REVERSE</string>
    <string name="protocol_tor_reverse_desc">The tunnel through Tor. The network never sees WARP (TCP only).</string>
    <string name="protocol_tor_only">TOR ONLY</string>
    <string name="protocol_tor_only_desc">Plain Tor without WARP. Exit is a Tor exit node.</string>
    <string name="protocol_psiphon">PSIPHON (BETA)</string>
    <string name="protocol_psiphon_desc">Experimental Psiphon transport built into the core.</string>

